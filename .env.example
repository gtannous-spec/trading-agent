# =============================================================================
# Trader Agent -- Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# -- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://trader:trader_dev@localhost:5432/trader_agent
ASYNC_DATABASE_URL=postgresql+asyncpg://trader:trader_dev@localhost:5432/trader_agent
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -- HTTP ---------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=30.0

# -- API Keys -----------------------------------------------------------------
FINNHUB_API_KEY=
NEWSAPI_API_KEY=
TWITTER_BEARER_TOKEN=
STOCKTWITS_ACCESS_TOKEN=

# -- NLP / Model --------------------------------------------------------------
FINBERT_MODEL_NAME=ProsusAI/finbert
FINBERT_DEVICE=cpu

# -- Alerting -----------------------------------------------------------------
WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENTS=

# -- Scheduling ---------------------------------------------------------------
INGEST_FUNDAMENTALS_CRON=0 6 * * 1-5
INGEST_INSIDER_TRADES_CRON=0 7 * * 1-5
INGEST_NEWS_INTERVAL_MINUTES=30
INGEST_SOCIAL_INTERVAL_MINUTES=15

# -- Prediction ---------------------------------------------------------------
PREDICTION_HORIZON_DAYS=90
DEFAULT_MODEL_TYPE=lightgbm
